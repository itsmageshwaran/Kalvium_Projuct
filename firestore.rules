rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Function to check if the user has a specific role
    function hasRole(role) {
      return isAuthenticated() && request.auth.token.role == role;
    }

    // Users Collection
    match /users/{userId} {
      // Users can read their own profile, or Campus Managers can read all profiles
      allow read: if isAuthenticated() && (request.auth.uid == userId || hasRole('CAMPUS_MANAGER'));
      
      // Users can update their own profile, but CANNOT self-elevate role or modify another user's document
      allow write: if isAuthenticated() && request.auth.uid == userId
                   && (!('role' in request.resource.data) || (resource != null && request.resource.data.role == resource.data.role));

      // Saved Events Subcollection
      match /savedEvents/{eventId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    // Events Collection
    match /events/{eventId} {
      // Public / authenticated access to campus events
      allow read: if isAuthenticated();
      
      // Organizers, Students, and Campus Managers can create events (non-managers must submit as PENDING)
      allow create: if (hasRole('ORGANIZER') || hasRole('CAMPUS_MANAGER') || hasRole('STUDENT'))
                    && (request.resource.data.status == 'PENDING' || hasRole('CAMPUS_MANAGER'));
      
      // Organizers and Students can update their own events, but CANNOT alter status (cannot self-approve).
      // Only Campus Managers can approve or decline events.
      allow update: if hasRole('CAMPUS_MANAGER') || 
                   ((hasRole('ORGANIZER') || hasRole('STUDENT')) && resource.data.organizerId == request.auth.uid
                    && request.resource.data.status == resource.data.status);
      
      // Campus Managers can delete any event; Organizers and Students can delete their own events
      allow delete: if hasRole('CAMPUS_MANAGER') || 
                   ((hasRole('ORGANIZER') || hasRole('STUDENT')) && resource.data.organizerId == request.auth.uid);

      // Analyses Subcollection (AI analysis results)
      match /analyses/{analysisId} {
        allow read: if isAuthenticated();
        allow write: if false; // Only written by admin SDK
      }

      // Approval History Subcollection
      match /approvalHistory/{historyId} {
        allow read: if isAuthenticated();
        allow write: if false; // Only written by admin SDK
      }
    }
  }
}
