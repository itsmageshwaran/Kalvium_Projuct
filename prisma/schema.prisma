generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String            @id @default(cuid())
  name            String
  email           String            @unique
  password        String
  role            String            @default("STUDENT") // STUDENT | ORGANIZER | CAMPUS_MANAGER
  avatar          String?
  createdAt       DateTime          @default(now())

  organizedEvents Event[]           @relation("EventOrganizer")
  verifiedEvents  Event[]           @relation("EventVerifier")
  savedEvents     SavedEvent[]
  approvals       ApprovalHistory[]
}

model Event {
  id                 String            @id @default(cuid())
  title              String
  description        String
  summary            String
  date               String            // Format: YYYY-MM-DD
  startTime          String            // Format: HH:mm (24h) or "10:00 AM"
  endTime            String            // Format: HH:mm (24h) or "01:00 PM"
  venue              String
  organizerName      String?
  posterUrl          String
  category           String            // Workshop, Hackathon, Cultural, Technical, Sports, Seminar, Competition, Club, Fest
  tags               String?           // Comma separated or JSON string
  registrationUrl    String?
  contactInfo        String?
  status             String            @default("PENDING") // DRAFT | PENDING | APPROVED | DECLINED
  declineReason      String?
  declineCustomNotes String?

  organizerId        String
  organizer          User              @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)

  verifiedById       String?
  verifiedBy         User?             @relation("EventVerifier", fields: [verifiedById], references: [id])
  verifiedAt         DateTime?

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  savedBy            SavedEvent[]
  analyses           EventAnalysis[]
  approvalHistory    ApprovalHistory[]

  @@index([status])
  @@index([date])
  @@index([category])
  @@index([organizerId])
  @@index([status, date])
  @@index([status, category])
}

model SavedEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  savedAt   DateTime @default(now())

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
}

model EventAnalysis {
  id                 String   @id @default(cuid())
  eventId            String?
  event              Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rawExtractedData   String   // JSON string of all extracted fields
  confidenceData     String   // JSON string of field-level confidence ratings (High, Medium, Low)
  duplicatesDetected String?  // JSON string of potential duplicate matches
  analyzedAt         DateTime @default(now())

  @@index([eventId])
  @@index([analyzedAt])
}

model ApprovalHistory {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  managerId String
  manager   User     @relation(fields: [managerId], references: [id])
  action    String   // APPROVED | DECLINED
  reason    String?
  notes     String?
  timestamp DateTime @default(now())

  @@index([eventId])
  @@index([managerId])
  @@index([timestamp])
}
