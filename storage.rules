rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function hasRole(role) {
      return isAuthenticated() && request.auth.token.role == role;
    }

    match /event-posters/{eventId}/{allPaths=**} {
      // Anyone authenticated can read posters
      allow read: if isAuthenticated();
      // Only Organizers, Students, and Campus Managers can upload posters
      // We allow upload of images only, up to a certain size
      allow write: if (hasRole('ORGANIZER') || hasRole('CAMPUS_MANAGER') || hasRole('STUDENT'))
                   && request.resource.contentType.matches('image/.*')
                   && request.resource.size < 10 * 1024 * 1024; // 10MB max
    }
    
    match /{allPaths=**} {
      // Default deny for everything else
      allow read, write: if false;
    }
  }
}
